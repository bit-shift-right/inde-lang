const PI = 3.141592653

type Shape = circle( f32 ) | rect( f32 f32 ) | tri( f32 f32 )

word area(Shape -> f32)
  match
    case circle
      let radius in
        radius dup * PI *
      end

    case rect
      let width height in
        width height *
      end

    case tri
      let base height in
        2.0 base / height *
      end
  end
end

word main ( -> )
  2.0 circle area print
  2.0 4.0 rect area print
  2.0 4.0 tri area print
end
