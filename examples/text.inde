word count-chars ( str -> u32 )
  0u32 0u32 let text count offset in
    count offset
    while
      dup text swap str-char-at match
        case some char-utf8-len let n o width in n 1u32 + o width + true end
        case none false
      end
    do end
    drop
  end
end

word rotate ( str u32 -> str )
  strbuf-new 0u32 let text shift buffer offset in
    buffer offset
    while
      dup text swap str-char-at match
        case some
          let b o c in
            c to-u32 97u32 - shift + 26u32 % 97u32 + to-char
            let rotated in b rotated strbuf-push o c char-utf8-len + true end
          end
        case none false
      end
    do end
    drop strbuf-freeze
  end
end

word describe-byte ( i32 -> str )
  to-u8.checked match
    case some to-u32 to-char str-from-char "fits in a byte: " swap str-concat
    case none "does not fit in a byte"
  end
end

word main ( -> )
  "héllo" str-len print
  "héllo" count-chars print
  "héllo" 1u32 3u32 str-slice match case some print case none "none" print end
  "hello" 13u32 rotate print
  "uryyb" 13u32 rotate print
  72 describe-byte print
  300 describe-byte print
  300 to-u8.wrap print
  300 to-u8.sat print
  7 2 / to-f64 print
  7 to-f64 2 to-f64 / print
  -2.7 to-i32 print
  "Hi" str-to-bytes bytes-to-str match case ok print case err drop "bad" print end
  { 0xFFu8 } bytes-to-str match case ok print case err print end
end
