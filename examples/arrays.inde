word sum ( array[i32] -> i32 )
  0 swap arraybuf-from-array [ + ] arraybuf-consume
end

word largest ( array[i32] -> Option[i32] )
  dup array-len 0u32 == if
    drop none
  else
    dup 0u32 array-get swap arraybuf-from-array
    [ over over < if swap end drop ] arraybuf-consume
    some
  end
end

word squares ( u32 -> array[u32] )
  let count in
    arraybuf-new 1u32
    while dup count <= do
      let buffer n in buffer n n * arraybuf-push n 1u32 + end
    end
    drop arraybuf-freeze
  end
end

word reversed ( array[i32] -> array[i32] )
  arraybuf-new swap arraybuf-from-array
  while arraybuf-len 0u32 > do
    arraybuf-pop match
      case some let target source n in target n arraybuf-push source end
      case none
    end
  end
  arraybuf-freeze drop arraybuf-freeze
end

word bracketed ( arraybuf[strbuf] -> str )
  strbuf-new swap
  [ strbuf-freeze swap "[" strbuf-append swap strbuf-append "]" strbuf-append ]
  arraybuf-consume
  strbuf-freeze
end

word main ( -> )
  { 3 1 4 1 5 9 2 6 } sum print
  { 3 1 4 1 5 9 2 6 } largest match case some print case none "empty" print end
  { 1 2 3 } reversed 0u32 array-get print
  5u32 squares 4u32 array-get print
  { 10 20 30 } 1u32 3u32 array-slice sum print
  { 10 20 30 } 7u32 array-get.checked match
    case some print
    case none "no element 7" print
  end
  arraybuf-new
  "one" strbuf-from-str arraybuf-push
  "two" strbuf-from-str arraybuf-push
  bracketed print
end
